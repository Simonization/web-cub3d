# Copy to .env.local (gitignored) and fill in. Never commit the real key.
# Generate one with:  npm run bugs -- keygen

# Used by scripts/bugs.mjs (CLI) and by `npm run bugs:dev` (local server).
BUGS_ADMIN_KEY=
# Where the CLI sends requests. Use http://127.0.0.1:8787 against `npm run bugs:dev`.
BUGS_URL=https://play.langerock.xyz
